<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
    <InternalsVisibleTo Include="FlintsLabs.D365.ODataClient.Tests" />
  </ItemGroup>

  <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        
        <!-- NuGet Package Info -->
        <PackageId>FlintsLabs.D365.ODataClient</PackageId>
        <Version>2.0.0</Version>
        <Authors>FlintsLabs</Authors>
        <Company>FlintsLabs</Company>
        <Product>D365 OData Client</Product>
        <Description>Fail-closed fluent OData client for Microsoft Dynamics 365 Finance and Operations and Dataverse. Provides strongly typed LINQ queries, CRUD responses, typed failures, validated pagination, named clients, and shared token management for Azure AD and ADFS.</Description>
        <PackageTags>D365;OData;Dynamics365;FluentAPI;FinanceOperations;FO;SCM;ADFS;AzureAD</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://github.com/FlintsLabs/FlintsLabs.D365.ODataClient</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FlintsLabs/FlintsLabs.D365.ODataClient</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>2.0.0 is a breaking fail-closed release. High-level reads and mutations preserve HTTP, authentication, transport, timeout, protocol, and serialization failures instead of returning default values. It adds D365Response, typed exceptions, mutation outcomes, strict counts, validated pagination, bounded read retries, cancellation, named singleton clients, and single-flight token refresh. Migration guide: https://github.com/FlintsLabs/FlintsLabs.D365.ODataClient/blob/v2.0.0/docs/v2/migration-from-v1.md</PackageReleaseNotes>
        
        <!-- Package settings -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="Assets\FlintsLabs-Logo-512.png" Pack="true" PackagePath="icon.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Identity.Client" Version="4.67.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="8.0.11" />
    </ItemGroup>

</Project>
